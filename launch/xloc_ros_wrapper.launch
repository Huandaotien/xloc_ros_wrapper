<launch>
    <node pkg="xloc_ros_wrapper"
          type="xloc_ros_node"
          name="xloc_ros_node"
          output="screen"
    >
        <param name="use_sim_time" value="false"/>
    </node>
    
    <!-- Start the C API-based xloc node in addition to the C++ node -->
    <!-- <node pkg="xloc_ros_wrapper"
          type="xloc_ros_node_capi"
          name="xloc_ros_node_capi"
          output="screen"
    >
        <param name="use_sim_time" value="false"/>
    </node> -->

    <!-- RViz with the virtual line / code visualization preconfigured.
         Disable with use_rviz:=false. -->
    <arg name="use_rviz" default="true"/>
    <node if="$(arg use_rviz)"
          pkg="rviz"
          type="rviz"
          name="rviz"
          args="-d $(find xloc_ros_wrapper)/rviz/virtual_lines.rviz"
          output="screen"
    />
</launch>